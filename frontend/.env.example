# Public project connection info; never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.

# Server-only. Replace privately in .env.local or Vercel, never commit real values.
RESEARCH_ALLOWED_EMAIL=researcher@example.com
RESEARCH_SITE_URL=http://localhost:3000
